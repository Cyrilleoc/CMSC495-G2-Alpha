# Optional: enable external model-assisted paraphrasing of approved FAQ content.
# Never commit a real API key. Local retrieval works without credentials.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ALPHA_DB_PATH=data/alpha.db
# Set to e.g. 60 to demonstrate a basic 429 handler; 0 disables it.
DEMO_RATE_LIMIT=0
